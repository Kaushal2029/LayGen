# Laygen Environment Variables Template
# Copy this file to .env.local and fill in your API keys

# Gemini AI (for text generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Replicate AI (for image generation)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# DeepAI (for image generation) - RECOMMENDED
DEEPAI_API_KEY=your_deepai_api_key_here

# Perplexity AI (for code generation and analysis) - NEW!
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI (fallback for text and images)
OPENAI_API_KEY=your_openai_api_key_here

# Figma (optional - for Figma integration)
FIGMA_API_KEY=your_figma_api_key_here
NEXT_PUBLIC_FIGMA_WEBHOOK_SECRET=your_figma_webhook_secret_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Instructions:
# 1. Copy this file to .env.local
# 2. Get your API keys:
#    - Gemini: https://makersuite.google.com/app/apikey
#    - DeepAI: https://deepai.org/api-key
#    - Perplexity: https://www.perplexity.ai/settings/api
#    - Replicate: https://replicate.com/account/api-tokens
#    - OpenAI: https://platform.openai.com/api-keys
#    - Figma: https://www.figma.com/developers/api#access-tokens
# 3. Replace the placeholder values with your actual API keys
# 4. Restart your development server

# Priority for AI services:
# 1. Perplexity AI (if PERPLEXITY_API_KEY + DEEPAI_API_KEY are set) - NEW! RECOMMENDED
# 2. DeepAI Primary (if GEMINI_API_KEY + DEEPAI_API_KEY are set)
# 3. Hybrid AI (if GEMINI_API_KEY + REPLICATE_API_TOKEN are set)
# 4. Legacy Hybrid (if GEMINI_API_KEY + OPENAI_API_KEY are set)
# 5. Gemini only (if only GEMINI_API_KEY is set)
# 6. OpenAI only (if only OPENAI_API_KEY is set)

# Priority for image generation:
# 1. DeepAI (if DEEPAI_API_KEY is set) - RECOMMENDED
# 2. Replicate AI (if DEEPAI_API_KEY is not set but REPLICATE_API_TOKEN is set)
# 3. OpenAI (if neither DeepAI nor Replicate is set but OPENAI_API_KEY is set)
# 4. No image generation (if none are set)